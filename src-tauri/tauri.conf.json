{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "arolms",
  "version": "1.0.0",
  "identifier": "ir.aroedu",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "local-pages",
        "remote-site"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "mez",
    "copyright": "Copyright (c) mez",
    "shortDescription": "Example website packaged with Universal Web2App",
    "longDescription": "Example website packaged with Universal Web2App"
  },
  "plugins": {
    "web2app-native": {
      "downloads": true,
      "statusBarColor": "#3b82f6",
      "navigationBarColor": "#ffffff"
    }
  }
}
