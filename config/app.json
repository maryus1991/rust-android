{
  "schemaVersion": 1,
  "app": {
    "name": "arolms",
    "identifier": "ir.aroedu",
    "version": "1.0.0",
    "description": "Example website packaged with Universal Web2App",
    "author": {
      "name": "mez",
      "email": "maryus19915123@gmail.com"
    },
    "copyright": "Copyright (c) mez",
    "defaultLanguage": "fa",
    "defaultTheme": "system"
  },
  "site": {
    "name": "بنیاد اموزشی آرو",
    "url": "https://aroedu.ir",
    "domain": "aroedu.ir",
    "includeSubdomains": true,
    "allowedDomains": [],
    "userAgent": ""
  },
  "appearance": {
    "primaryColor": "#3b82f6",
    "backgroundColor": "#ffffff",
    "statusBarColor": "#3b82f6",
    "navigationBarColor": "#ffffff",
    "splashColor": "#ffffff",
    "iconSource": "assets/icon/icon.png",
    "logoSource": "assets/splash/logo.png"
  },
  "platforms": {
    "windows": true,
    "linux": true,
    "android": true,
    "ios": false
  },
  "features": {
    "fileUpload": true,
    "camera": false,
    "microphone": true,
    "geolocation": false,
    "downloads": true,
    "notifications": false,
    "clipboard": true,
    "externalApps": true,
    "fullscreen": true,
    "networkMonitoring": false,
    "multipleWindows": false,
    "paymentHandoff": false
  },
  "security": {
    "httpsOnly": true,
    "outOfScopeLinks": "system-browser",
    "externalSchemes": [
      "tel",
      "mailto",
      "sms"
    ],
    "paymentSchemes": []
  },
  "behavior": {
    "loadTimeoutSecs": 20,
    "hangTimeoutSecs": 120,
    "crashWatchdog": true,
    "maxAutoRecoveries": 3
  },
  "release": {
    "mode": "both"
  }
}
